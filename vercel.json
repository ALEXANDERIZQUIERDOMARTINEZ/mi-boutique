{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "mi-boutique.vercel.app"
        }
      ],
      "destination": "https://mishelles.store/:path*",
      "permanent": true
    },
    {
      "source": "/mayor.html",
      "has": [
        {
          "type": "host",
          "value": "mishelles.store"
        }
      ],
      "destination": "https://fabrica.mishelles.store/",
      "permanent": true
    },
    {
      "source": "/encargo.html",
      "has": [
        {
          "type": "host",
          "value": "mishelles.store"
        }
      ],
      "destination": "https://fabrica.mishelles.store/encargo.html",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "fabrica.mishelles.store"
        }
      ],
      "destination": "/mayor.html"
    },
    {
      "source": "^/$",
      "has": [
        {
          "type": "host",
          "value": "ameigroup.mishelles.store"
        }
      ],
      "destination": "/login.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)\\.(js|css)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
