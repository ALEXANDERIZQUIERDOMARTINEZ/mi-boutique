rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ═══════════════════════════════════════════════════════════════════
    // FUNCIONES AUXILIARES - AUTENTICACIÓN
    // ═══════════════════════════════════════════════════════════════════

    // Verifica si el usuario está autenticado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Verifica si el usuario existe en la colección usuarios
    function isRegisteredUser() {
      return isAuthenticated() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));
    }

    // Obtiene los datos del usuario actual
    function getUserData() {
      return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;
    }

    // Verifica si el usuario está activo
    function isActiveUser() {
      return isRegisteredUser() && getUserData().activo == true;
    }

    // Verifica si el usuario tiene un permiso específico. Super Admin
    // siempre pasa, sin importar qué tenga guardado en su propio mapa de
    // permisos — igual que en el cliente (auth.js: hasPermission() ahí
    // también hace isSuperAdmin() ? true : ...). Sin este atajo, una cuenta
    // Super Admin creada antes de que existiera un permiso nuevo (p.ej.
    // inventario_fabrica_gestionar, agregado con el módulo de Fábrica)
    // queda bloqueada de ese módulo para siempre por no tener esa llave
    // en su documento — aunque su rol sea SUPER_ADMIN.
    function hasPermission(permission) {
      return isActiveUser() &&
             (getUserData().rol == 'SUPER_ADMIN' || getUserData().permisos[permission] == true);
    }

    // ═══════════════════════════════════════════════════════════════════
    // FUNCIONES MULTI-TENANT - CRÍTICAS
    // ═══════════════════════════════════════════════════════════════════

    // Verifica si el usuario es Super Admin (sin tenantId)
    function isSuperAdmin() {
      return isActiveUser() && getUserData().rol == 'SUPER_ADMIN';
    }

    // Verifica si el usuario pertenece a un tenant específico
    function belongsToTenant(tenantId) {
      return isActiveUser() &&
             (getUserData().tenantId == tenantId || isSuperAdmin());
    }

    // Verifica si el documento que se está creando tiene el tenantId correcto
    // Super Admin no tiene tenantId propio (no pertenece a ninguna
    // empresa), así que esta comparación nunca puede dar verdadero para
    // él sin un atajo — igual que hasPermission() y belongsToTenant(),
    // se le deja crear con cualquier tenantId que el cliente ya validó
    // (window.expectedTenantId, fijo por página).
    function isCreatingWithCorrectTenant() {
      return isSuperAdmin() || request.resource.data.tenantId == getUserData().tenantId;
    }

    // Verifica que no se intente cambiar el tenantId en una actualización
    function isNotChangingTenant() {
      return !('tenantId' in request.resource.data) ||
             request.resource.data.tenantId == resource.data.tenantId;
    }

    // Verifica que el documento que se está creando tenga tenantId
    function hasRequiredTenantId() {
      return 'tenantId' in request.resource.data;
    }

    // ID del contador de facturas del tenant del usuario actual
    function tenantCounterId() {
      return 'facturas_' + (getUserData().tenantId == null ? 'default' : getUserData().tenantId);
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE TENANTS - SOLO SUPER ADMINS
    // ═══════════════════════════════════════════════════════════════════

    match /tenants/{tenantId} {
      // Lectura pública: nombre, logo y color de marca (nada sensible),
      // los necesita el selector de empresa del login antes de que se
      // sepa a cuál empresa pertenece quien está entrando.
      allow read: if true;

      // Solo Super Admins pueden crear/editar tenants
      allow create, update: if isSuperAdmin();

      // NUNCA eliminar tenants (usar estado "cancelado")
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE PLANES - SOLO SUPER ADMINS
    // ═══════════════════════════════════════════════════════════════════

    match /planes/{planId} {
      // Lectura pública (para mostrar en onboarding)
      allow read: if true;

      // Solo Super Admins pueden gestionar planes
      allow create, update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE USUARIOS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /usuarios/{userId} {
      // Leer propio documento
      allow read: if isAuthenticated() && request.auth.uid == userId;

      // Super Admin puede leer todos los usuarios
      allow read: if isSuperAdmin();

      // Admin Tenant puede leer usuarios de su tenant
      allow read: if isActiveUser() &&
                    hasPermission('usuarios_ver') &&
                    belongsToTenant(resource.data.tenantId);

      // Crear: Super Admin o Admin Tenant (con tenantId correcto)
      allow create: if isSuperAdmin() ||
                      (hasPermission('usuarios_crear') &&
                       hasRequiredTenantId() &&
                       isCreatingWithCorrectTenant());

      // Actualizar: Solo del mismo tenant, sin cambiar tenantId
      allow update: if isSuperAdmin() ||
                      (hasPermission('usuarios_editar') &&
                       belongsToTenant(resource.data.tenantId) &&
                       isNotChangingTenant());

      // Eliminar: Solo Super Admin
      allow delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE PRODUCTOS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /productos/{productId} {
      // Lectura pública para el catálogo web (todos los tenants)
      allow read: if true;

      // Crear: Con tenantId correcto
      allow create: if hasPermission('productos_crear') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      // Actualizar: edición completa del catálogo (productos_editar), o
      // solo bajar el stock al registrar una venta (ventas_crear) — el
      // Vendedor no tiene productos_editar, pero SÍ necesita poder
      // descontar stock al vender, sin que eso le dé permiso de tocar
      // precio/nombre/etc. Se restringe a que el único campo que cambie
      // sea variaciones.
      allow update: if belongsToTenant(resource.data.tenantId) &&
                      isNotChangingTenant() &&
                      (hasPermission('productos_editar') ||
                       (hasPermission('ventas_crear') &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variaciones'])));

      // Eliminar: Solo del mismo tenant
      allow delete: if hasPermission('productos_eliminar') &&
                      belongsToTenant(resource.data.tenantId);
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE VENTAS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /ventas/{saleId} {
      // Leer: Usuario activo con permiso de ventas o dashboard.
      // Fábrica también puede leer, pero SOLO ventas mayoristas (las usa
      // para sumar sus ingresos), nunca las ventas al detal de la boutique.
      // No requiere tenantId en el documento para compatibilidad con registros anteriores
      allow read: if isActiveUser() &&
                    (hasPermission('ventas_ver') || hasPermission('dashboard_ver') ||
                     (hasPermission('fabrica_gestionar') && resource.data.tipoVenta == 'mayorista'));

      // Crear: Con tenantId correcto
      allow create: if hasPermission('ventas_crear') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      // Actualizar: ventas_editar para edición completa, ventas_anular para anulación
      // Permite docs sin tenantId (registros anteriores a migración)
      allow update: if isActiveUser() &&
                      (hasPermission('ventas_editar') || hasPermission('ventas_anular')) &&
                      (!resource.data.keys().hasAny(['tenantId']) ||
                       (belongsToTenant(resource.data.tenantId) && isNotChangingTenant()));

      // Eliminar: Solo con permiso explícito ventas_eliminar
      // Permite docs sin tenantId (registros anteriores a migración)
      allow delete: if isActiveUser() &&
                      hasPermission('ventas_eliminar') &&
                      (!resource.data.keys().hasAny(['tenantId']) ||
                       belongsToTenant(resource.data.tenantId));
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE FACTURAS - GENERADAS A PARTIR DE VENTAS (1 factura x venta)
    // ═══════════════════════════════════════════════════════════════════

    match /facturas/{facturaId} {
      // Leer: quien puede ver ventas. Permite docs sin tenantId (legacy)
      allow read: if hasPermission('ventas_ver') &&
                    (!resource.data.keys().hasAny(['tenantId']) ||
                     belongsToTenant(resource.data.tenantId));

      // Crear: quien puede registrar ventas, con tenantId correcto
      allow create: if hasPermission('ventas_crear') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      // No se edita ni elimina una factura ya generada
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE AUDITORÍA - REGISTRO DE QUIÉN CREA/EDITA/ELIMINA
    // ═══════════════════════════════════════════════════════════════════

    match /auditoria/{logId} {
      // Leer: solo quien tenga el permiso explícito de auditoría
      allow read: if hasPermission('auditoria_ver');

      // Crear: cualquier usuario activo puede dejar su propio registro,
      // pero solo puede firmarlo como sí mismo (no puede suplantar a otro
      // usuario ni cambiar el tenant del que forma parte)
      allow create: if isActiveUser() &&
                      request.resource.data.usuarioId == request.auth.uid &&
                      (!('tenantId' in request.resource.data) ||
                       isSuperAdmin() ||
                       request.resource.data.tenantId == getUserData().tenantId);

      // Es un log inmutable: nunca se edita ni se elimina
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE CONTADORES - CONSECUTIVOS INTERNOS (p.ej. numeración factura)
    // ═══════════════════════════════════════════════════════════════════

    match /contadores/{contadorId} {
      allow read: if (hasPermission('ventas_ver') || hasPermission('ventas_crear')) &&
                    (contadorId == tenantCounterId() || isSuperAdmin());

      allow write: if hasPermission('ventas_crear') &&
                     (contadorId == tenantCounterId() || isSuperAdmin());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE CLIENTES - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /clientes/{clientId} {
      // Lectura/creación/actualización pública: el checkout de la tienda
      // (app.js, sin sesión) verifica si el cliente ya existe por cédula
      // y crea/actualiza su registro ahí mismo. Restaura el mismo alcance
      // que tenía esta colección en las reglas de desarrollo — no es una
      // regresión de privacidad nueva, es lo que ya corría en producción.
      // TODO: mover esto a una Cloud Function que valide el upsert en vez
      // de dejar la colección abierta a escritura directa.
      allow read: if true;
      allow create: if true;
      allow update: if true;

      // Eliminar: solo staff con permiso, del mismo tenant
      allow delete: if hasPermission('clientes_eliminar') &&
                      belongsToTenant(resource.data.tenantId);
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE PEDIDOS WEB - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /pedidosWeb/{pedidoId} {
      // Creación pública desde el catálogo (DEBE incluir tenantId)
      allow create: if hasRequiredTenantId();

      // Leer: Solo del mismo tenant
      allow read: if hasPermission('pedidos_web_ver') &&
                    belongsToTenant(resource.data.tenantId);

      // Actualizar: Solo del mismo tenant, sin cambiar tenantId
      allow update: if hasPermission('pedidos_web_gestionar') &&
                      belongsToTenant(resource.data.tenantId) &&
                      isNotChangingTenant();

      // No eliminar pedidos
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE COTIZACIONES - CON VALIDACIÓN DE TENANT
    // (creadas desde el panel de Ventas para enviar al cliente lo que
    //  debe cancelar; se aceptan o rechazan como los pedidos web)
    // ═══════════════════════════════════════════════════════════════════

    match /cotizaciones/{cotizacionId} {
      // Leer: quien puede registrar/ver ventas, solo del mismo tenant
      allow read: if (hasPermission('ventas_ver') || hasPermission('ventas_crear')) &&
                    belongsToTenant(resource.data.tenantId);

      // Crear: quien puede registrar ventas, con tenantId correcto
      allow create: if hasPermission('ventas_crear') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      // Actualizar (aceptar/rechazar): Solo del mismo tenant, sin cambiar tenantId
      allow update: if hasPermission('ventas_editar') &&
                      belongsToTenant(resource.data.tenantId) &&
                      isNotChangingTenant();

      // No eliminar cotizaciones
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE APARTADOS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /apartados/{apartadoId} {
      // Leer: Solo del mismo tenant
      allow read: if hasPermission('apartados_ver') &&
                    belongsToTenant(resource.data.tenantId);

      // Crear: Con tenantId correcto
      allow create: if hasPermission('apartados_crear') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      // Actualizar: Solo del mismo tenant, sin cambiar tenantId
      allow update: if hasPermission('apartados_editar') &&
                      belongsToTenant(resource.data.tenantId) &&
                      isNotChangingTenant();

      // Eliminar: Solo del mismo tenant
      allow delete: if hasPermission('apartados_eliminar') &&
                      belongsToTenant(resource.data.tenantId);
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE CATEGORÍAS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /categorias/{categoryId} {
      // Lectura pública: el catálogo web (app.js, sin sesión) las necesita
      // para el filtro por categoría — mismo criterio que productos.
      allow read: if true;

      // Crear: Con tenantId correcto
      allow create: if hasPermission('categorias_gestionar') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      // Actualizar y eliminar: Solo del mismo tenant
      allow update, delete: if hasPermission('categorias_gestionar') &&
                              belongsToTenant(resource.data.tenantId) &&
                              isNotChangingTenant();
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE PROVEEDORES - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /proveedores/{supplierId} {
      // Leer: Solo del mismo tenant
      allow read: if hasPermission('proveedores_gestionar') &&
                    belongsToTenant(resource.data.tenantId);

      // Gestionar: Solo del mismo tenant
      allow create, update, delete: if hasPermission('proveedores_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE REPARTIDORES - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /repartidores/{repartidorId} {
      // Leer: Solo del mismo tenant
      allow read: if hasPermission('repartidores_gestionar') &&
                    belongsToTenant(resource.data.tenantId);

      // Gestionar: Solo del mismo tenant
      allow create, update, delete: if hasPermission('repartidores_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE MOVIMIENTOS FINANCIEROS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /movimientosFinancieros/{movimientoId} {
      allow read: if hasPermission('finanzas_ver') &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('finanzas_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // COLECCIONES LEGACY - datos de antes de que existiera tenantId,
    // solo se leen desde los botones de exportar/backup de Boutique.
    // No se escribe en ellas desde la app; no aplica belongsToTenant
    // porque los documentos no tienen ese campo.
    // ═══════════════════════════════════════════════════════════════════

    match /finanzas/{movimientoId} {
      allow read: if hasPermission('finanzas_ver');
      allow write: if false;
    }

    match /pedidos/{pedidoId} {
      allow read: if hasPermission('pedidos_web_ver');
      allow write: if false;
    }

    // Barrios sugeridos desde el checkout público (app.js) cuando el
    // cliente escribe uno que no está en la lista predefinida. Sin
    // tenantId — es de la tienda pública de Boutique, igual que antes.
    match /barrios/{barrioId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE FÁBRICA - SEGMENTO APARTE (gastos vs. ingresos propios)
    // ═══════════════════════════════════════════════════════════════════

    match /movimientosFabrica/{movimientoId} {
      allow read: if hasPermission('fabrica_gestionar') &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('fabrica_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE INVENTARIO FÁBRICA - HILAZAS, HILOS Y TELAS
    // ═══════════════════════════════════════════════════════════════════

    match /inventarioFabrica/{itemId} {
      allow read: if hasPermission('inventario_fabrica_gestionar') &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('inventario_fabrica_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE PRODUCTOS FÁBRICA - CATÁLOGO PROPIO, SIN COMPARTIR CON BOUTIQUE
    // ═══════════════════════════════════════════════════════════════════

    match /productosFabrica/{productoId} {
      // Lectura pública: mayor.html (catálogo mayorista de Fábrica, sin
      // sesión) lo necesita — mismo criterio que productos de Boutique.
      allow read: if true;

      allow create, delete: if hasPermission('inventario_fabrica_gestionar') &&
                              (resource == null || belongsToTenant(resource.data.tenantId)) &&
                              (request.resource == null || isCreatingWithCorrectTenant());

      // Igual que productos de Boutique: gestión completa del catálogo, o
      // solo bajar stock al registrar una venta de mostrador — restringido
      // a que el único campo que cambie sea variaciones.
      allow update: if belongsToTenant(resource.data.tenantId) &&
                      isNotChangingTenant() &&
                      (hasPermission('inventario_fabrica_gestionar') ||
                       (hasPermission('ventas_crear') &&
                        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['variaciones'])));
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE BOUTIQUE - GASTOS E INGRESOS OPERATIVOS (segmento Finanzas)
    // ═══════════════════════════════════════════════════════════════════

    match /movimientosBoutique/{movimientoId} {
      allow read: if hasPermission('finanzas_ver') &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('finanzas_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE CIERRES DE CAJA - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /cierresCaja/{cierreId} {
      allow read: if (hasPermission('cierres_caja') || hasPermission('finanzas_ver')) &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('cierres_caja') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE CHAT - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /chatConversations/{conversationId} {
      // Crear: Público pero con tenantId requerido
      allow create: if hasRequiredTenantId();

      // Leer: Público (para clientes) o con permiso (para staff)
      allow read: if true;

      // Responder: Solo staff del tenant
      allow update: if hasPermission('chat_responder') &&
                      belongsToTenant(resource.data.tenantId) &&
                      isNotChangingTenant();

      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE METAS - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /metas/{metaId} {
      allow read: if (hasPermission('dashboard_ver') || hasPermission('finanzas_ver')) &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('finanzas_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE PROMOCIONES - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /promociones/{promoId} {
      // Lectura pública (para catálogo)
      allow read: if true;

      allow create, update, delete: if hasPermission('promociones_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    match /promocionesGlobales/{promoId} {
      // Lectura pública (para catálogo)
      allow read: if true;

      allow create, update, delete: if hasPermission('promociones_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS DE OTRAS COLECCIONES - CON VALIDACIÓN DE TENANT
    // ═══════════════════════════════════════════════════════════════════

    match /ordenesRecepcion/{ordenId} {
      allow read: if hasPermission('productos_ver') &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('productos_editar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    match /liquidaciones/{liquidacionId} {
      allow read: if (hasPermission('repartidores_gestionar') || hasPermission('finanzas_ver')) &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('repartidores_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    match /abonos/{abonoId} {
      allow read: if hasPermission('apartados_ver') &&
                    belongsToTenant(resource.data.tenantId);

      allow create, update, delete: if hasPermission('apartados_gestionar') &&
                                      (resource == null || belongsToTenant(resource.data.tenantId)) &&
                                      (request.resource == null || isCreatingWithCorrectTenant()) &&
                                      (resource == null || request.resource == null || isNotChangingTenant());
    }

    match /historial_cargues/{cargueId} {
      allow read: if hasPermission('productos_ver') &&
                    belongsToTenant(resource.data.tenantId);

      allow create: if hasPermission('productos_importar') &&
                      hasRequiredTenantId() &&
                      isCreatingWithCorrectTenant();

      allow update, delete: if isSuperAdmin();
    }

    // ═══════════════════════════════════════════════════════════════════
    // AUDIT LOGS - SOLO SUPER ADMINS
    // ═══════════════════════════════════════════════════════════════════

    match /auditLogs/{logId} {
      // Solo Super Admins pueden leer audit logs
      allow read: if isSuperAdmin();

      // Escritura por sistema (Cloud Functions)
      allow create: if true;

      // Nunca eliminar logs
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS COMPROBANTES - Imágenes de pago (acceso público de solo lectura)
    // ═══════════════════════════════════════════════════════════════════

    match /comprobantes/{comprobanteId} {
      // Cualquiera puede leer (el admin ve la imagen desde el link en WhatsApp)
      allow read: if true;
      // Solo crear, nunca modificar ni borrar
      allow create: if true;
      allow update, delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // REGLAS CONFIG - QR y configuración pública de la tienda
    // ═══════════════════════════════════════════════════════════════════

    match /config/{docId} {
      // Lectura pública (catálogo necesita leer el QR de Nequi)
      allow read: if true;
      // Solo usuarios admin autenticados pueden escribir
      allow create, update: if isActiveUser();
      allow delete: if false;
    }

    // ═══════════════════════════════════════════════════════════════════
    // DENEGAR ACCESO A CUALQUIER OTRA COLECCIÓN NO ESPECIFICADA
    // ═══════════════════════════════════════════════════════════════════

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
